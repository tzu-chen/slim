import Lean
import SlimExport.Compat

/-!
# slim-export

A small, version-pinned semantic exporter for slim. It imports the
already-built modules of one project into a single environment (so imported
library declarations appear once, deduplicated by their canonical name),
and writes plain JSON Lines describing:

* every module of the environment and its imports;
* every declaration of the requested local modules: kind, flags, elaborated
  type (pretty-printed), binders, documentation, declaration ranges, and
  the constants occurring in its elaborated type, in its value (proof term or
  definition body) and, for inductive types, its constructors;
* library declarations reachable from the local ones (configurable), with
  the same reference lists, so that axiom dependencies can be traced.

It never elaborates source files, never runs Lake, and (for Lean ≥ 4.21)
does not run the environment-extension import hooks of the loaded modules.
The output is untrusted data for slim's importer.
-/

open Lean Meta

namespace SlimExport

def exporterVersion : String := "0.1.0"

structure Config where
  out : String := ""
  searchPath : Array String := #[]
  modules : Array Name := #[]
  modulesFile : Option String := none
  library : String := "full"
  libraryTypes : String := "frontier"
  validateAxioms : Bool := false
  maxLibraryDecls : Nat := 2000000
  ppWidth : Nat := 100
  /-- `notation`: load environment extensions (runs project initializers and
  attribute handlers) so that types are printed with their notation;
  `raw`: do not run any code from the imported modules. -/
  pp : String := "notation"

partial def parseArgs (cfg : Config) : List String → Except String Config
  | [] => .ok cfg
  | "--out" :: v :: rest => parseArgs { cfg with out := v } rest
  | "--search-path" :: v :: rest => parseArgs { cfg with searchPath := cfg.searchPath.push v } rest
  | "--module" :: v :: rest => parseArgs { cfg with modules := cfg.modules.push v.toName } rest
  | "--modules-file" :: v :: rest => parseArgs { cfg with modulesFile := some v } rest
  | "--library" :: v :: rest =>
    if v == "full" || v == "frontier" || v == "none" then parseArgs { cfg with library := v } rest
    else .error s!"--library expects full|frontier|none, got {v}"
  | "--library-types" :: v :: rest =>
    if v == "all" || v == "frontier" || v == "none" then parseArgs { cfg with libraryTypes := v } rest
    else .error s!"--library-types expects all|frontier|none, got {v}"
  | "--validate-axioms" :: rest => parseArgs { cfg with validateAxioms := true } rest
  | "--pp" :: v :: rest =>
    if v == "notation" || v == "raw" then parseArgs { cfg with pp := v } rest
    else .error s!"--pp expects notation|raw, got {v}"
  | "--max-library-decls" :: v :: rest =>
    match v.toNat? with
    | some n => parseArgs { cfg with maxLibraryDecls := n } rest
    | none => .error "--max-library-decls expects a number"
  | "--pp-width" :: v :: rest =>
    match v.toNat? with
    | some n => parseArgs { cfg with ppWidth := n } rest
    | none => .error "--pp-width expects a number"
  | a :: _ => .error s!"unknown or incomplete argument: {a}"

/-- Lean's own convention: name components starting with `_`, numeric
components, and `match_N`/`proof_N`/`eq_N`/`omega_N` suffixes are internal.
(Re-implemented here because the helper is not available in every supported
version.) -/
def numberedSuffix (s pre : String) : Bool :=
  s.startsWith pre && s.length > pre.length && (s.drop pre.length).all (fun c => c.isDigit || c == '_')

def internalName : Name → Bool
  | .str p s =>
    s.startsWith "_" || numberedSuffix s "match_" || numberedSuffix s "proof_" ||
      numberedSuffix s "eq_" || numberedSuffix s "omega_" || internalName p
  | .num _ _ => true
  | .anonymous => false

/-- Last components of declarations that only Lean generates. -/
def generatedLast : List String :=
  ["recOn", "casesOn", "below", "brecOn", "binductionOn", "ibelow", "noConfusion",
   "noConfusionType", "inj", "injEq", "sizeOf_spec", "ctorIdx", "toCtorIdx", "ctorElim",
   "ctorElimType", "eq_def", "eq_unfold", "induct", "mutual_induct"]

def userName (n : Name) : Name := (privateToUserName? n).getD n

def generatedReason (env : Environment) (n : Name) (ci : ConstantInfo) : Option String :=
  let u := userName n
  match ci with
  | .recInfo _ => some "recursor generated for an inductive type"
  | _ =>
    if isAuxRecursor env n then some "auxiliary recursor generated for an inductive type"
    else if isNoConfusion env n then some "noConfusion principle generated for an inductive type"
    else if internalName u then some "internal auxiliary declaration generated by Lean"
    else match u with
      | .str _ s => if generatedLast.contains s then some s!"`{s}` declaration generated by Lean" else none
      | _ => none

def kindOf (env : Environment) (instances classes : NameSet) (n : Name) (ci : ConstantInfo) : String :=
  match ci with
  | .axiomInfo _ => "axiom"
  | .defnInfo d =>
    if instances.contains n then "instance"
    else match d.hints with
      | .abbrev => "abbrev"
      | _ => "def"
  | .thmInfo _ => if instances.contains n then "instance" else "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quot"
  | .inductInfo _ =>
    if classes.contains n then "class"
    else if isStructure env n then "structure"
    else "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

def flagsOf (env : Environment) (instances classes : NameSet) (n : Name) (ci : ConstantInfo) : Array Json := Id.run do
  let mut fs : Array Json := #[]
  if isPrivateName n then fs := fs.push "private"
  if isProtected env n then fs := fs.push "protected"
  if instances.contains n then fs := fs.push "instance"
  if classes.contains n then fs := fs.push "class"
  if ci.isUnsafe then fs := fs.push "unsafe"
  if ci.isPartial then fs := fs.push "partial"
  if isNoncomputable env n then fs := fs.push "noncomputable"
  if (env.getProjectionFnInfo? n).isSome then fs := fs.push "projection"
  if isStructure env n then fs := fs.push "structure"
  return fs

/-- Constants in the type, in the value, and constructors (for inductives). -/
def refsOf (ci : ConstantInfo) : Array Name × Array Name × Array Name :=
  let t := ci.type.getUsedConstants
  let v := match ci with
    | .defnInfo d => d.value.getUsedConstants
    | .thmInfo d => d.value.getUsedConstants
    | .opaqueInfo d => d.value.getUsedConstants
    | _ => #[]
  let c := match ci with
    | .inductInfo d => d.ctors.toArray
    | _ => #[]
  (t, v, c)

def hasValue (ci : ConstantInfo) : Bool :=
  match ci with
  | .defnInfo _ | .thmInfo _ | .opaqueInfo _ => true
  | _ => false

def nameJson (n : Name) : Json := Json.str n.toString

def namesJson (ns : Array Name) : Json := Json.arr (ns.map nameJson)

def binderInfoStr : BinderInfo → String
  | .default => "default"
  | .implicit => "implicit"
  | .strictImplicit => "strict_implicit"
  | .instImplicit => "inst_implicit"

def displayBinderName (n : Name) : String :=
  if n.hasMacroScopes then n.eraseMacroScopes.toString ++ "✝" else n.toString

def ppTypeAndBinders (ty : Expr) (width : Nat) (withBinders : Bool) : MetaM (String × Option (Array Json × String)) := do
  let full := (← ppExpr ty).pretty width
  if !withBinders then
    return (full, none)
  let bs ← forallTelescope ty fun xs body => do
    let mut arr : Array Json := #[]
    for x in xs do
      let ld ← x.fvarId!.getDecl
      let t := (← ppExpr ld.type).pretty width
      arr := arr.push (Json.mkObj [("name", Json.str (displayBinderName ld.userName)),
        ("info", Json.str (binderInfoStr ld.binderInfo)), ("type", Json.str t)])
    let c := (← ppExpr body).pretty width
    return (arr, c)
  return (full, some bs)

def rangeJson (r : DeclarationRange) : Json :=
  Json.mkObj [("start", toJson #[r.pos.line, r.pos.column]), ("end", toJson #[r.endPos.line, r.endPos.column]),
    ("start_utf16", toJson r.charUtf16), ("end_utf16", toJson r.endCharUtf16)]

structure Stats where
  modules : Nat := 0
  decls : Nat := 0
  localDecls : Nat := 0
  libraryDecls : Nat := 0
  libraryTruncated : Bool := false
  ppFailures : Nat := 0

def emit (h : IO.FS.Handle) (j : Json) : IO Unit :=
  h.putStrLn j.compress

/-- Runs a `MetaM` action with fresh meta state; failures become `none`. -/
def tryMeta (x : MetaM α) : CoreM (Option α) := do
  try
    let a ← x.run'
    return some a
  catch _ =>
    return none

def declRecord (cfg : Config) (env : Environment) (instances classes : NameSet) (modName : Name)
    (isLocal : Bool) (withType withDoc withEdges : Bool) (n : Name) (ci : ConstantInfo) :
    CoreM (Json × Bool) := do
  let mut fields : List (String × Json) :=
    [("record", "decl"), ("name", nameJson n), ("kind", Json.str (kindOf env instances classes n ci)),
     ("module", nameJson modName), ("local", Json.bool isLocal),
     ("flags", Json.arr (flagsOf env instances classes n ci))]
  if let some g := generatedReason env n ci then
    fields := fields ++ [("generated", Json.str g)]
  let mut ppFailed := false
  if withType then
    let generated := (generatedReason env n ci).isSome
    match ← tryMeta (ppTypeAndBinders ci.type cfg.ppWidth (isLocal && !generated)) with
    | some (t, bs?) =>
      fields := fields ++ [("type", Json.str t)]
      if let some (bs, c) := bs? then
        fields := fields ++ [("binders", Json.arr bs), ("conclusion", Json.str c)]
    | none => ppFailed := true
  if withDoc then
    if let some d ← (findDocString? env n : IO (Option String)) then
      fields := fields ++ [("doc", Json.str d)]
  if isLocal then
    if let some r ← findDeclarationRanges? n then
      fields := fields ++ [("range", rangeJson r.range), ("selection", rangeJson r.selectionRange)]
  if withEdges then
    let (t, v, c) := refsOf ci
    fields := fields ++ [("refs", Json.mkObj [("type", namesJson t), ("value", namesJson v), ("ctor", namesJson c)])]
    fields := fields ++ [("coverage", Json.mkObj [("type", "complete"),
      ("value", Json.str (if hasValue ci then "complete" else "not_applicable"))])]
  else
    fields := fields ++ [("coverage", Json.mkObj [("type", "not_extracted"), ("value", "not_extracted")])]
  if isLocal && cfg.validateAxioms then
    let axs ← collectAxioms n
    fields := fields ++ [("lean_axioms", namesJson axs)]
  return (Json.mkObj fields, ppFailed)

def instanceNamesOf (env : Environment) (idx : Nat) : Array Name := Id.run do
  let mut out : Array Name := #[]
  for e in Meta.instanceExtension.ext.getModuleEntries env idx do
    match e with
    | .global ie => if let some n := ie.globalName? then out := out.push n
    | .scoped _ ie => if let some n := ie.globalName? then out := out.push n
  return out

def classNamesOf (env : Environment) (idx : Nat) : Array Name :=
  (PersistentEnvExtension.getModuleEntries classExtension env idx).map (·.name)

unsafe def run (cfg : Config) : IO Stats := do
  let t0 ← IO.monoMsNow
  searchPathRef.set (cfg.searchPath.toList.map System.FilePath.mk)
  if cfg.modules.isEmpty then
    throw <| IO.userError "no modules requested"
  if cfg.pp == "raw" && !Compat.rawModeSupported then
    throw <| IO.userError "--pp raw is not supported on this Lean version (extensions are always loaded)"
  let loadExts := cfg.pp == "notation" || !Compat.rawModeSupported
  if loadExts then
    enableInitializersExecution
  let env ← Compat.importEnv (cfg.modules.map fun m => ({ module := m } : Import)) loadExts
  let h ← IO.FS.Handle.mk cfg.out .write
  let mods := env.allImportedModuleNames
  let localSet : NameSet := cfg.modules.foldl (fun s m => s.insert m) {}
  -- Instance and class tables from module entries (works with or without
  -- loaded extension state).
  let mut instances : NameSet := {}
  let mut classes : NameSet := {}
  for i in [0:mods.size] do
    for n in instanceNamesOf env i do instances := instances.insert n
    for n in classNamesOf env i do classes := classes.insert n
  emit h <| Json.mkObj [("record", "exporter_header"), ("exporter", "slim-export"),
    ("exporter_version", Json.str exporterVersion), ("compat", Json.str Compat.variant),
    ("loads_extensions", Json.bool loadExts), ("runs_initializers", Json.bool loadExts),
    ("pp", Json.str cfg.pp), ("olean_level", Json.str Compat.oleanLevel),
    ("lean_version", Json.str Lean.versionString), ("lean_githash", Json.str Lean.githash),
    ("modules_requested", toJson cfg.modules.size), ("library", Json.str cfg.library),
    ("library_types", Json.str cfg.libraryTypes), ("validate_axioms", Json.bool cfg.validateAxioms)]
  let mut modCount : Nat := 0
  -- Modules.
  for i in [0:mods.size] do
    let m := mods[i]!
    let data := env.header.moduleData[i]!
    let imps := data.imports.map fun imp =>
      Json.mkObj [("module", nameJson imp.module), ("flags", toJson (Compat.importFlags imp))]
    let doc := match getModuleDoc? env m with
      | some ds => if ds.isEmpty then Json.null else Json.str (String.intercalate "\n\n" (ds.toList.map (·.doc)))
      | none => Json.null
    emit h <| Json.mkObj [("record", "module"), ("name", nameJson m), ("local", Json.bool (localSet.contains m)),
      ("imports", Json.arr imps), ("doc", doc)]
    modCount := modCount + 1
  let coreCtx : Core.Context := { fileName := "<slim-export>", fileMap := default, maxHeartbeats := 0 }
  let coreState : Core.State := { env := env }
  let action : CoreM Stats := do
    let mut stats : Stats := { modules := modCount }
    let mut seen : NameSet := {}
    let mut queue : Array Name := #[]
    -- Local declarations, module by module in import order.
    for i in [0:mods.size] do
      let m := mods[i]!
      unless localSet.contains m do continue
      let data := env.header.moduleData[i]!
      for n in data.constNames do
        seen := seen.insert n
      for n in data.constNames, ci in data.constants do
        let (j, failed) ← declRecord cfg env instances classes m true true true true n ci
        emit h j
        stats := { stats with decls := stats.decls + 1, localDecls := stats.localDecls + 1,
                              ppFailures := stats.ppFailures + (if failed then 1 else 0) }
        let (t, v, c) := refsOf ci
        for r in t ++ v ++ c do
          unless seen.contains r do
            seen := seen.insert r
            queue := queue.push r
    -- Library closure (breadth-first, bounded).
    let frontier := queue.size
    if cfg.library != "none" then
      let mut k := 0
      while k < queue.size do
        if stats.libraryDecls ≥ cfg.maxLibraryDecls then
          stats := { stats with libraryTruncated := true }
          break
        let n := queue[k]!
        k := k + 1
        let some ci := env.find? n | continue
        let isFrontier := k ≤ frontier
        if cfg.library == "frontier" && !isFrontier then continue
        let modName := match env.getModuleIdxFor? n with
          | some idx => mods[idx.toNat]!
          | none => Name.anonymous
        let withType := cfg.libraryTypes == "all" || (cfg.libraryTypes == "frontier" && isFrontier)
        let withEdges := cfg.library == "full"
        let (j, failed) ← declRecord cfg env instances classes modName false withType isFrontier withEdges n ci
        emit h j
        stats := { stats with decls := stats.decls + 1, libraryDecls := stats.libraryDecls + 1,
                              ppFailures := stats.ppFailures + (if failed then 1 else 0) }
        if withEdges then
          let (t, v, c) := refsOf ci
          for r in t ++ v ++ c do
            unless seen.contains r do
              seen := seen.insert r
              queue := queue.push r
    return stats
  let (stats, _) ← action.toIO coreCtx coreState
  let t1 ← IO.monoMsNow
  emit h <| Json.mkObj [("record", "exporter_footer"), ("modules", toJson stats.modules),
    ("decls", toJson stats.decls), ("local_decls", toJson stats.localDecls),
    ("library_decls", toJson stats.libraryDecls), ("library_truncated", Json.bool stats.libraryTruncated),
    ("pp_failures", toJson stats.ppFailures), ("elapsed_ms", toJson (t1 - t0))]
  h.flush
  return stats

end SlimExport

open SlimExport in
unsafe def main (args : List String) : IO UInt32 := do
  let cfg ← match parseArgs {} args with
    | .ok c => pure c
    | .error e =>
      IO.eprintln s!"slim-export: {e}"
      return 2
  let cfg ← match cfg.modulesFile with
    | some f => do
      let lines ← IO.FS.lines f
      let ms := lines.filter (fun l => !l.isEmpty) |>.map String.toName
      pure { cfg with modules := cfg.modules ++ ms }
    | none => pure cfg
  if cfg.out.isEmpty then
    IO.eprintln "slim-export: --out FILE is required"
    return 2
  try
    let s ← run cfg
    IO.eprintln s!"slim-export: {s.localDecls} local and {s.libraryDecls} library declarations, {s.modules} modules"
    return 0
  catch e =>
    IO.eprintln s!"slim-export: error: {e}"
    return 1
